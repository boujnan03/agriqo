# Copy to .env (same folder as docker-compose.yml) to override defaults.

# Backend base URL as seen from the user's BROWSER (not the Docker service name).
# Baked into the frontend bundle at build time: after changing it, run
# `docker compose up --build`. Used only by src/services/ (not wired to any page yet).
VITE_API_BASE_URL=http://localhost:8000
