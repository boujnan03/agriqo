# Copy to .env (same folder as docker-compose.yml) to override defaults.

# Backend base URL as seen from the user's BROWSER (not the Docker service name).
# Baked into the frontend bundle at build time: after changing it, run
# `docker compose up --build`. Used by src/services/api.ts (Home, Farm, Insights, Weather).
VITE_API_BASE_URL=http://localhost:8000

# OpenTopography API key (relief block: altitude + slope from SRTM GL1). Free: create an
# account at https://portal.opentopography.org/newUser, then MyOpenTopo dashboard > "Get an API Key".
# Read by the backend only (never baked into the frontend). Unset -> the relief block
# answers status "indisponible" with error "missing_api_key"; everything else still works.
OPENTOPO_API_KEY=
